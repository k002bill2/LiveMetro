{
  "name": "livemetro-app",
  "version": "1.0.0",
  "description": "실시간 전철 알림 - Real-time subway notification app for Seoul metropolitan area",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "patch-package",
    "start": "EXPO_NO_METRO_LAZY=1 expo start",
    "android": "EXPO_NO_METRO_LAZY=1 expo run:android",
    "ios": "EXPO_NO_METRO_LAZY=1 expo run:ios",
    "web": "EXPO_NO_METRO_LAZY=1 expo start --web",
    "build": "expo build",
    "build:development": "eas build --platform all --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:production": "eas build --platform all --profile production",
    "build:ios": "eas build --platform ios --profile production-ios",
    "build:android": "eas build --platform android --profile production-android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:all": "eas submit --platform all",
    "lint": "eslint . --ext .ts,.tsx --fix && npm run --silent lint:plugins",
    "lint:plugins": "eslint plugins --ext .js --max-warnings 0",
    "lint:typography": "node scripts/lint-typography.cjs",
    "lint:typography:audit": "find src -type f \\( -name '*.ts' -o -name '*.tsx' \\) -print0 | xargs -0 node scripts/lint-typography.cjs",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:hooks": "node --test '.claude/hooks/__tests__/*.test.js'",
    "prebuild": "npm run lint && npm run type-check",
    "presubmit": "npm run lint && npm run type-check && npm run test",
    "skills:update": "ts-node scripts/skillsGuideUpdater.ts",
    "skills:update:force": "ts-node scripts/skillsGuideUpdater.ts --force",
    "skills:check": "ts-node scripts/skillsGuideUpdater.ts --check-only",
    "codex:sync-prompts": "node scripts/sync-codex-command-prompts.mjs",
    "codex:install-commands-skill": "node scripts/sync-codex-command-prompts.mjs --install-user-skill",
    "upload:stations": "ts-node scripts/uploadStationsToFirebase.ts",
    "backup:claude": "ts-node scripts/backupClaudeConfig.ts",
    "restore:claude": "ts-node scripts/restoreClaudeConfig.ts",
    "restore:claude:latest": "ts-node scripts/restoreClaudeConfig.ts --latest",
    "restore:claude:list": "ts-node scripts/restoreClaudeConfig.ts --list",
    "clone:claude": "ts-node scripts/cloneClaudeConfig.ts",
    "clone:claude:check": "ts-node scripts/cloneClaudeConfig.ts --dry-run",
    "e2e:install": "appium driver list --installed | grep -q uiautomator2 || appium driver install uiautomator2; appium driver list --installed | grep -q xcuitest || appium driver install xcuitest",
    "e2e:appium": "appium --port 4723 --allow-cors",
    "e2e:build:android": "expo run:android --variant debug",
    "e2e:build:ios": "expo run:ios --configuration Debug",
    "e2e:android": "wdio e2e/config/wdio.android.conf.ts",
    "e2e:ios": "wdio e2e/config/wdio.ios.conf.ts",
    "e2e:mock-server": "json-server --watch e2e/data/mock-db.json --port 3001",
    "e2e:report": "allure generate e2e/reports/allure-results --clean -o e2e/reports/allure-report && allure open e2e/reports/allure-report"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-google-signin/google-signin": "^10.1.2",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.25",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.17",
    "expo-build-properties": "~55.0.18",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-local-authentication": "~55.0.18",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.27",
    "expo-print": "~55.0.19",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.20",
    "expo-updates": "~55.0.33",
    "firebase": "^10.7.1",
    "lucide-react-native": "^0.562.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@wdio/allure-reporter": "^8.43.0",
    "@wdio/appium-service": "^8.46.0",
    "@wdio/cli": "^8.46.0",
    "@wdio/local-runner": "^8.46.0",
    "@wdio/mocha-framework": "^8.46.0",
    "@wdio/spec-reporter": "^8.43.0",
    "allure-commandline": "^2.36.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^3.10.0",
    "appium-xcuitest-driver": "^6.2.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "dotenv": "^16.6.1",
    "eslint": "^8.50.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "expect-webdriverio": "^4.15.4",
    "firebase-admin": "^13.6.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.22",
    "json-server": "^0.17.4",
    "patch-package": "^8.0.1",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "keywords": [
    "subway",
    "notification",
    "real-time",
    "react-native",
    "firebase",
    "seoul",
    "transportation"
  ],
  "author": "LiveMetro Team",
  "license": "MIT",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-markdown-display",
          "@react-native-seoul/kakao-login",
          "firebase"
        ]
      }
    }
  }
}
