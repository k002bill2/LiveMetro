{
  "name": "livemetro-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for LiveMetro email notifications",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "eslint --ext .ts src/",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.0",
    "expo-server-sdk": "^8.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
